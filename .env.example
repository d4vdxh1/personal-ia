# Plantilla sin credenciales. Copiar a .env.local en la raíz.
# Completar las dos variables públicas para ejecutar la app con Supabase.

# Supabase: configuración pública prevista para la conexión.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase: solo servidor; completar únicamente si una operación lo requiere.
# Nunca agregar NEXT_PUBLIC_ a esta clave.
SUPABASE_SERVICE_ROLE_KEY=

# Integraciones futuras; dejar vacías durante la fase 0. Solo servidor.
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
