# Plantilla sin credenciales. Copiar a .env.local en la raíz.
# Completar las dos variables públicas para ejecutar la app con Supabase.

# Supabase: configuración pública prevista para la conexión.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase: solo servidor; completar únicamente si una operación lo requiere.
# Nunca agregar NEXT_PUBLIC_ a esta clave.
SUPABASE_SERVICE_ROLE_KEY=

# Fase 4A: Gemini solo en el servidor (requerida para activar /assistant).
# Crear en https://aistudio.google.com/apikey y configurar en Vercel; nunca NEXT_PUBLIC_ ni subir secretos.
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL pública canónica para enlaces de registro y recuperación de contraseña.
# Producción: https://personal-ia-two.vercel.app ; local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://personal-ia-two.vercel.app
