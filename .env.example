# Plantilla sin credenciales. Copiar a .env.local en la raíz.
# Completar las dos variables públicas para ejecutar la app con Supabase.

# Supabase: configuración pública prevista para la conexión.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase: solo servidor; completar únicamente si una operación lo requiere.
# Nunca agregar NEXT_PUBLIC_ a esta clave.
SUPABASE_SERVICE_ROLE_KEY=

# Fase 4A: Gemini solo en el servidor (requerida para activar /assistant).
# Crear en https://aistudio.google.com/apikey y configurar en Vercel; nunca NEXT_PUBLIC_ ni subir secretos.
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL pública canónica para enlaces de registro y recuperación de contraseña.
# Producción: https://personal-ia-two.vercel.app ; local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://personal-ia-two.vercel.app

# Registro público: habilitar únicamente cuando SMTP, plantillas y antiabuso estén probados.
# Estas banderas son SOLO de servidor. Dejar en false para lanzamiento inicial con Google.
EMAIL_SIGNUP_ENABLED=false
EMAIL_RECOVERY_ENABLED=false

# Fase 4B.3: la migración 20261108033000_ai_study_actions ya está aplicada.
# El valor false permite deshabilitar las escrituras si hay que revertirlas sin cambiar la DB.
AI_STUDY_WRITES_ENABLED=true

# Web Push 5A.2: mostrar la clave pública VAPID solo después de aprobar la migración.
WEB_PUSH_VAPID_PUBLIC_KEY=
# Secretos exclusivos de Supabase Edge Functions: NO usar NEXT_PUBLIC_
# WEB_PUSH_VAPID_PRIVATE_KEY, WEB_PUSH_VAPID_SUBJECT, CRON_SECRET
